{
  "name": "croatian-armageddon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Croatian Armageddon \u2014 a 7-round card game created by Dese",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "simulate": "tsx src/sim/run.ts",
    "compare": "tsx src/sim/compare.ts",
    "playthrough": "node scripts/playthrough.mjs",
    "fixture": "tsx src/sim/fixture.ts",
    "icons": "node scripts/build-icons.mjs",
    "icons:preview": "node scripts/preview-adaptive-icon.mjs /tmp/adaptive-icon.png"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
